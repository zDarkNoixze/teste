# Apache / shared hosting (cPanel). Every block is guarded so missing modules never cause a 500.
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType application/octet-stream .hdr
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType text/javascript .js .mjs
  AddType application/wasm .wasm
</IfModule>

# Serve precompressed .br/.gz siblings (generated by `pnpm build`) when the client accepts them.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.(js|mjs|css|html|svg|json|hdr|txt|xml|wasm))$ $1.br [L,QSA]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+\.(js|mjs|css|html|svg|json|hdr|txt|xml|wasm))$ $1.gz [L,QSA]

  # The rewrite above hides the original type; restore it.
  RewriteRule \.js\.(br|gz)$ - [T=text/javascript,E=no-gzip:1]
  RewriteRule \.mjs\.(br|gz)$ - [T=text/javascript,E=no-gzip:1]
  RewriteRule \.css\.(br|gz)$ - [T=text/css,E=no-gzip:1]
  RewriteRule \.html\.(br|gz)$ - [T=text/html,E=no-gzip:1]
  RewriteRule \.svg\.(br|gz)$ - [T=image/svg+xml,E=no-gzip:1]
  RewriteRule \.json\.(br|gz)$ - [T=application/json,E=no-gzip:1]
  RewriteRule \.hdr\.(br|gz)$ - [T=application/octet-stream,E=no-gzip:1]
  RewriteRule \.txt\.(br|gz)$ - [T=text/plain,E=no-gzip:1]
  RewriteRule \.xml\.(br|gz)$ - [T=application/xml,E=no-gzip:1]
  RewriteRule \.wasm\.(br|gz)$ - [T=application/wasm,E=no-gzip:1]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|html|svg|json|hdr|txt|xml|wasm)\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|html|svg|json|hdr|txt|xml|wasm)\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Caching: hashed build files are immutable; entry points always revalidate.
  <FilesMatch "\.html(\.br|\.gz)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^poster\.json(\.br|\.gz)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|avif|svg|hdr|woff2?|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "/assets/[^/]+$" IMMUTABLE_ASSET
    Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
  </IfModule>
</IfModule>

# Fallback: on-the-fly compression for anything not precompressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml application/wasm application/octet-stream
</IfModule>
